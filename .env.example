# Supabase client configuration (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional legacy public key; use only if the project has not migrated to publishable keys.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only key; never prefix this with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# Public app URL used in links and notifications
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional public branding (the app has built-in defaults for each value)
NEXT_PUBLIC_APP_NAME=CUT-HRMERS
NEXT_PUBLIC_APP_SHORT_NAME=CUT-HRMERS
NEXT_PUBLIC_APP_SUBTITLE=Human Resource Management & Employee Retention
NEXT_PUBLIC_ORGANIZATION_NAME=Chinhoyi University of Technology
NEXT_PUBLIC_WORKSPACE_LABEL=Chinhoyi University of Technology
NEXT_PUBLIC_DEFAULT_USER_NAME=User
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com

# Supabase Edge Function secrets for scheduled email notifications.
# These are not read from the Next.js app's .env when deployed; configure them
# separately in Supabase Function secrets.
SUPABASE_URL=
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=
